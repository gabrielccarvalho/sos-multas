{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "ANTHROPIC_API_KEY",
    "EXTRACTION_MODEL",
    "STORAGE_DIR",
    "PROCURADOR_NAME",
    "PROCURADOR_CNPJ",
    "PROCURADOR_ADDRESS",
    "PROCURADOR_EMAIL",
    "PROCURADOR_PHONE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
